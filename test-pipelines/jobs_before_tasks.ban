#pragma test
    // trigger the pipeline
    trigger_pipeline(my_pipeline);

    expect [
        task_success(my_pipeline, build, cowsay),
        task_success(my_pipeline, build, test),
        job_success(my_pipeline, build),
        pipeline_success(my_pipeline),
    ];
#pragma end;

pipeline my_pipeline [
    build
]

job build [
    // this is a comment...
    cowsay,
    test
]

task cowsay(image: kmcgivern/cowsay-alpine:latest, execute: r#""#) {r#""#}
task test(image: kmcgivern/cowsay-alpine:latest, execute: r#""#) {r#""#}
