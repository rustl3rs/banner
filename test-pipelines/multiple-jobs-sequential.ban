import https://gist.githubusercontent.com/pms1969/464d6304014f9376be7e07b3ccf3a972/raw/a929e3feccd5384a00fe4e7ce6431f46dbb02951/cowsay.ban

[tag: rustl3rs.com/owner=pms1969]
task test(image: rust:latest, execute: "bash -exo pipefail -c") {
    r#"
    cd /source-code

    # would be good to capture code coverage stats here.
    cargo test
    "#
}

job unit-test [
    cowsay,
    test,
]

job coverage [
    cowsay,
]

job pre-load [
    cowsay,
]

job finish [
    cowsay,
]

pipeline sequential [
    pre-load,
    unit-test,
    coverage,
    sonarqube,
    finish,
]

// basically a stateless pipeline at present.
// when loaded, it must be manually triggered
// bigger pipeline than the others to test out that multiple jobs are triggered correctly.

#pragma test
    trigger_pipeline(sequential);
    expect [
        task_success(sequential, unit-test, test),
        task_success(sequential, unit-test, cowsay),
        job_success(sequential, pre-load, cowsay),
        job_success(sequential, coverage, cowsay),
        job_success(sequential, sonarqube, cowsay),
        job_success(sequential, finish, cowsay),
        job_success(sequential, pre-load),
        job_success(sequential, unit-test),
        job_success(sequential, coverage),
        job_success(sequential, sonarqube),
        job_success(sequential, finish),
        pipeline_success(sequential),
    ];
#pragma end;
